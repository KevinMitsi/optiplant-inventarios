  ORGANIZATION {
    uuid id PK
    varchar code UK
    varchar name
    boolean active
  }
  BRANCH {
    uuid id PK
    uuid organization_id FK
    varchar code
    varchar name
    boolean active
  }
  APP_ROLE {
    uuid id PK
    varchar code UK
  }
  APP_USER {
    uuid id PK
    uuid organization_id FK
    uuid branch_id FK "nullable, admin"
    uuid role_id FK
    varchar email UK
    varchar password_hash
    boolean active
  }
  CATEGORY {
    uuid id PK
    uuid organization_id FK
    varchar code
    varchar name
  }
  UNIT_OF_MEASURE {
    uuid id PK
    varchar code UK
    varchar symbol
  }
  PRODUCT {
    uuid id PK
    uuid organization_id FK
    uuid category_id FK
    uuid unit_id FK
    uuid parent_product_id FK "self, 1 nivel"
    varchar sku UK
    varchar barcode
    boolean active
  }
  INVENTORY {
    uuid id PK
    uuid branch_id FK
    uuid product_id FK
    decimal quantity
    decimal minimum_stock
    decimal average_cost
    int version
  }
  INVENTORY_ADJUSTMENT {
    uuid id PK
    uuid branch_id FK
    uuid created_by FK
    uuid approved_by FK
    varchar reason
  }
  INVENTORY_ADJUSTMENT_ITEM {
    uuid id PK
    uuid adjustment_id FK
    uuid product_id FK
    decimal quantity_delta
  }
  INVENTORY_MOVEMENT {
    uuid id PK
    uuid inventory_id FK
    varchar movement_type
    uuid user_id FK
    decimal quantity
    decimal unit_cost
    uuid purchase_order_id FK
    uuid sale_id FK
    uuid transfer_id FK
    uuid adjustment_id FK
  }
  INVENTORY_ALERT {
    uuid id PK
    uuid inventory_id FK
    varchar alert_type
    varchar status
    decimal triggered_quantity
  }
  SUPPLIER {
    uuid id PK
    uuid organization_id FK
    varchar code
  }
  PURCHASE_ORDER {
    uuid id PK
    uuid branch_id FK
    uuid supplier_id FK
    uuid created_by FK
    varchar status
    varchar order_number
  }
  PURCHASE_ORDER_ITEM {
    uuid id PK
    uuid purchase_order_id FK
    uuid product_id FK
    decimal quantity
    decimal received_quantity
    decimal unit_price
  }
  PRICE_LIST {
    uuid id PK
    uuid organization_id FK
    varchar code
    date valid_from
    date valid_until
  }
  PRODUCT_PRICE {
    uuid id PK
    uuid price_list_id FK
    uuid product_id FK
    decimal price
  }
  SALE {
    uuid id PK
    uuid branch_id FK
    uuid created_by FK
    uuid price_list_id FK
    varchar status
    varchar sale_number
  }
  SALE_ITEM {
    uuid id PK
    uuid sale_id FK
    uuid product_id FK
    decimal quantity
    decimal unit_price
  }
  CARRIER {
    uuid id PK
    uuid organization_id FK
    varchar code
  }
  LOGISTICS_ROUTE {
    uuid id PK
    uuid organization_id FK
    uuid origin_branch_id FK
    uuid destination_branch_id FK
    int estimated_duration_minutes
  }
  TRANSFER {
    uuid id PK
    varchar transfer_number UK
    uuid origin_branch_id FK
    uuid destination_branch_id FK
    uuid requested_by FK
    uuid approved_by FK
    varchar status
    varchar priority
    uuid carrier_id FK
    uuid route_id FK
  }
  TRANSFER_ITEM {
    uuid id PK
    uuid transfer_id FK
    uuid product_id FK
    decimal requested_quantity
    decimal approved_quantity
    decimal shipped_quantity
    decimal received_quantity
  }
  TRANSFER_STATUS_HISTORY {
    uuid id PK
    uuid transfer_id FK
    varchar status
    uuid changed_by FK
  }
  TRANSFER_ISSUE {
    uuid id PK
    uuid transfer_item_id FK
    varchar issue_type
    varchar resolution_type
    decimal quantity
    uuid reported_by FK
    uuid resolved_by FK
  }
