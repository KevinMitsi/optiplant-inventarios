AD --> HU01
AD --> HU02
AD --> HU03

rectangle "EP-02 Gestión de sucursales" {
  usecase "HU-04 Crear sucursal" as HU04
  usecase "HU-05 Consultar sucursales" as HU05
  usecase "HU-06 Consultar inventario de otra sucursal" as HU06
}
